# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Environment variables and secrets
.env
.env.local
.env.*.local

# Distribution / packaging
build/
dist/
*.egg-info/
src/*.egg-info/

# Pytest / coverage
.pytest_cache/
.coverage
htmlcov/

# Logs and local runtime data
logs/*.log
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!logs/.gitkeep

# IDE / OS
.vscode/
.idea/
Thumbs.db
.DS_Store
