# ============================================================================
# ATLAS AI — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ============================================================================
# Copy this file to `.env` for local overrides.
# NEVER commit your actual `.env` file or real credentials to version control.
# ============================================================================

# --- Core Application Settings ---
ATLAS_ENV=development
ATLAS_LOG_LEVEL=INFO
ATLAS_LOG_DIR=logs
ATLAS_LOG_TO_FILE=true

# --- Trading & Instrument Defaults ---
ATLAS_PRIMARY_SYMBOL=XAUUSD
ATLAS_EXECUTION_MODE=backtest

# --- Safety & Live Trading Gate ---
# CRITICAL: Live trading is strictly disabled by default.
# Even if set to true in future phases, deterministic risk and execution gates
# require explicit secondary authorization before live orders can be placed.
ATLAS_LIVE_TRADING_ENABLED=false

# --- Future Phase Placeholders (Not Used in Phase 0) ---
# MetaTrader 5 Credentials (Phase: MT5 Integration)
# MT5_LOGIN=
# MT5_PASSWORD=
# MT5_SERVER=
# MT5_TERMINAL_PATH=

# Database Connection (Phase: Knowledge & Data Storage)
# DATABASE_URL=postgresql://user:password@localhost:5432/atlas_ai

# LLM / AI Provider API Keys (Phase: Knowledge Extraction)
# OPENAI_API_KEY=
# GEMINI_API_KEY=
